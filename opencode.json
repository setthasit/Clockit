{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "expo-mcp": {
      "type": "remote",
      "url": "https://mcp.expo.dev/mcp",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:EXPO_TOKEN}"
      }
    },
    "astryx": {
      "type": "remote",
      "url": "https://astryx.atmeta.com/mcp",
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest"],
      "enabled": true
    }
  }
}
