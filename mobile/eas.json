{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_AUTH0_DOMAIN": "REPLACE-ME-auth0-beta-tenant.us.auth0.com"
      }
    },
    "beta": {
      "distribution": "internal",
      "channel": "beta",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://clockit-api-beta.REPLACE-ME-TAILNET.ts.net",
        "EXPO_PUBLIC_AUTH0_DOMAIN": "REPLACE-ME-auth0-beta-tenant.us.auth0.com",
        "EXPO_PUBLIC_AUTH0_CLIENT_ID": "REPLACE-ME-auth0-beta-client-id",
        "EXPO_PUBLIC_AUTH0_AUDIENCE": "https://api.clockit.setthasit.dev"
      }
    },
    "production": {
      "distribution": "store",
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.clockit.setthasit.dev",
        "EXPO_PUBLIC_AUTH0_DOMAIN": "REPLACE-ME-auth0-prod-tenant.us.auth0.com",
        "EXPO_PUBLIC_AUTH0_CLIENT_ID": "REPLACE-ME-auth0-prod-client-id",
        "EXPO_PUBLIC_AUTH0_AUDIENCE": "https://api.clockit.setthasit.dev"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "REPLACE-ME-apple-id-email",
        "ascAppId": "REPLACE-ME-app-store-connect-app-id",
        "appleTeamId": "REPLACE-ME-apple-team-id"
      },
      "android": {
        "track": "internal"
      }
    }
  }
}
