# Copy to .env. EXPO_PUBLIC_* vars are inlined into the JS bundle at build time,
# so they are readable by anyone with the app — never put secrets here.

# LAN IP of the machine running `cd backend && make run`.
# localhost/127.0.0.1 will not resolve from a phone or a physical device.
EXPO_PUBLIC_API_URL=http://192.168.x.x:8080

# Auth0 tenant. The domain is also read by the react-native-auth0 config plugin
# in app.config.ts, so changing it requires a new native build.
EXPO_PUBLIC_AUTH0_DOMAIN=your-tenant.us.auth0.com
EXPO_PUBLIC_AUTH0_CLIENT_ID=your-native-app-client-id
# Must match AUTH0_AUDIENCE in backend/.env.
EXPO_PUBLIC_AUTH0_AUDIENCE=https://api.clockit.duckos.ai
